# Copia este archivo como .env y completa los valores localmente.
# No guardes el archivo .env real ni secretos en el repositorio.
N8N_DOMAIN=n8n.tu-dominio.example
ACME_EMAIL=tu-correo@example.com
# En una restauración, usa exactamente la clave de cifrado de la instancia n8n original.
# Si empiezas una instalación vacía, genera una clave aleatoria larga y guárdala en un gestor seguro.
N8N_ENCRYPTION_KEY=REEMPLAZAR_POR_UN_SECRETO_LARGO
