# Copia a .env y limita permisos del archivo (chmod 600 .env).
APP_DOMAIN=app.example.com
N8N_DOMAIN=n8n.example.com
ACME_EMAIL=admin@example.com

# PostgreSQL administrado en RDS; no expongas este endpoint públicamente.
DB_HOST=replace-with-rds-endpoint
DB_PORT=5432
DB_NAME=seguimiento_cronicos
DB_USER=app_user
DB_PASSWORD=replace-with-generated-password
DB_SSL=true
DB_SSL_CA=/run/certs/global-bundle.pem

# Genera secretos aleatorios fuera del repositorio.
JWT_SECRET=replace-with-at-least-32-random-characters
N8N_API_KEY=replace-with-a-different-long-random-secret
N8N_ENCRYPTION_KEY=replace-with-existing-n8n-key-to-preserve-credentials

# El archivo de la CA de RDS se descarga siguiendo MIGRACION_AWS.md.
