{
	email {$ACME_EMAIL}
	admin off
}

{$APP_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	@api path /api/*
	handle @api {
		reverse_proxy backend:3000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

{$N8N_DOMAIN} {
	encode zstd gzip
	reverse_proxy n8n:5678
}
