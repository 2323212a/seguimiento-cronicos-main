PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seguimiento_cronicos
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=
FRONTEND_ORIGINS=http://localhost:5173

# El trigger actual sigue siendo fuente productiva hasta la migración 003.
# Interruptor legado: true activa ambos evaluadores.
ALERTAS_BACKEND_ACTIVAS=false
# Activación independiente; las alertas de seguridad requieren criterios aprobados y activos.
ALERTAS_SEGURIDAD_ACTIVAS=false
ALERTAS_OBJETIVOS_ACTIVAS=false
OUTBOX_WORKER_ACTIVO=false

# --- Integración con n8n ---
# Clave compartida: n8n la envía en el header x-api-key al llamar /api/automatizacion/*
N8N_API_KEY=
# Webhook de n8n; el workflow debe reclamar y completar eventId antes de responder.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/medicion-registrada

# Solo para `npm run bootstrap:admin`; obtenerlos de un gestor de secretos y retirarlos después.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
